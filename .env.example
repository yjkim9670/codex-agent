MODEL_GEMINI_API_KEY=YOUR_GEMINI_API_KEY
MODEL_OPENAI_API_KEY=YOUR_OPENAI_API_KEY
MODEL_KIMI_API_KEY=YOUR_KIMI_API_KEY
MODEL_GLM_API_KEY=YOUR_GLM_API_KEY

# Claude: company (default) or native (preserve terminal login/key/endpoint/model mappings)
CODEX_CLAUDE_ENV_MODE=company
# CLI wait limits in seconds
CODEX_CLI_GATE_TIMEOUT_SECONDS=1800
CODEX_CLI_STDIN_TIMEOUT_SECONDS=60
CODEX_CLI_PROGRESS_TIMEOUT_SECONDS=600
CODEX_CLI_EXEC_TIMEOUT_SECONDS=3600

# Local voice transcription (model must be installed separately)
# Export these variables in the server environment, or store string values in
# .local/voice/config.json. Launchers do not load .env automatically.
# Explicit environment variables override the local JSON configuration.
CODEX_VOICE_ENABLED=false
CODEX_VOICE_MODEL=
# Optional executable overrides: CODEX_VOICE_FFMPEG, CODEX_VOICE_FFPROBE, CODEX_VOICE_WHISPER_CLI
